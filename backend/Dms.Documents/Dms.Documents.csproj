<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
    <PackageReference Include="QuestPDF" Version="2026.6.1" />
    <PackageReference Include="SkiaSharp" Version="4.148.0" />
    <PackageReference Include="HtmlAgilityPack" Version="1.11.72" />
  </ItemGroup>

  <!-- الخطوط تُضمَّن داخل المكتبة وتُحمَّل كـ Embedded Resource. Amiri/Cairo مفتوحة (OFL)؛
       Arial/Times New Roman مملوكة (Monotype) وُفِّرت من المالك للاستخدام الداخلي. -->
  <ItemGroup>
    <EmbeddedResource Include="Assets\Fonts\Amiri-Regular.ttf" />
    <EmbeddedResource Include="Assets\Fonts\Amiri-Bold.ttf" />
    <EmbeddedResource Include="Assets\Fonts\Cairo-Regular.ttf" />
    <EmbeddedResource Include="Assets\Fonts\Cairo-Bold.ttf" />
    <EmbeddedResource Include="Assets\Fonts\arial.ttf" />
    <EmbeddedResource Include="Assets\Fonts\arialbd.ttf" />
    <EmbeddedResource Include="Assets\Fonts\times.ttf" />
    <EmbeddedResource Include="Assets\Fonts\timesbd.ttf" />
  </ItemGroup>

</Project>
