<?xml version="1.0" encoding="utf-8"?>
<!--
  إعدادات IIS لخدمة واجهة Flutter Web.

  🔴 لماذا هذا الملف موجود: IIS **لا يعرف نوع `.wasm`** افتراضياً، فيردّ 404 على
     `canvaskit/canvaskit.wasm` — ومحرّك الرسم لا يُقلع، فتظهر صفحةٌ بيضاء بلا خطأٍ مفهوم.
     وهو في `app/web/` لا في مجلد البناء عمداً: كل `flutter build web` ينسخه إلى
     `build/web/` تلقائياً، **فلا يُنسى عند التحديث**.

  ⚠️ **وبلا أي قاعدة `<rewrite>`**: وحدة URL Rewrite **غير مثبّتة على IIS افتراضياً**،
     ووجودُ قاعدةٍ تحتاجها يجعل الموقع يردّ **500 على كل طلب**. والواجهة لا تحتاجها
     أصلاً لأنها تستعمل مسارات `#/` (بلا `usePathUrlStrategy`).
-->
<configuration>
  <system.webServer>
    <staticContent>
      <!-- `remove` قبل كل `mimeMap`: تعريفٌ مكرّر لامتدادٍ يعرفه IIS يُسقط الموقع بـ500. -->
      <remove fileExtension=".wasm" />
      <mimeMap fileExtension=".wasm" mimeType="application/wasm" />
      <remove fileExtension=".mjs" />
      <mimeMap fileExtension=".mjs" mimeType="text/javascript" />
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <remove fileExtension=".symbols" />
      <mimeMap fileExtension=".symbols" mimeType="text/plain" />
      <remove fileExtension=".otf" />
      <mimeMap fileExtension=".otf" mimeType="font/otf" />
      <remove fileExtension=".ttf" />
      <mimeMap fileExtension=".ttf" mimeType="font/ttf" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <remove fileExtension=".pdf" />
      <mimeMap fileExtension=".pdf" mimeType="application/pdf" />
    </staticContent>

    <defaultDocument>
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>
  </system.webServer>

  <!--
    ⚠️ خمسة ملفات **لا تُخزَّن في ذاكرة المتصفّح** — هي التي تحمل الإصدار أو تُعلنه.
       لو خُزِّنت بقي الموظف يرى النسخة القديمة بعد كل تحديث ويظنّ أن التحديث لم يصل.

    🔴 **تصحيح (ADR-050):** كان هنا أن `main.dart.js` «يُخزَّن بأمان لأن اسمه يتغيّر مع
       الإصدار» — **وهذا غير صحيح**: `main.dart.js` و`flutter_bootstrap.js` **بأسماءٍ ثابتة**
       لا تحمل بصمة. فبعد التحديث تُعيد الواجهةُ تحميل الصفحة (حين يختلف `version.json`)،
       فإن كان `main.dart.js` مخزَّناً **حُمِّلت النسخة القديمة من جديد** وتكرّرت الإعادة.
       حجمُه ~3 ميغابايت يُطلب مرّةً عند فتح الصفحة — ثمنٌ مقبول لإصدارٍ صحيح.
  -->
  <location path="index.html">
    <system.webServer>
      <staticContent><clientCache cacheControlMode="DisableCache" /></staticContent>
    </system.webServer>
  </location>
  <location path="flutter_service_worker.js">
    <system.webServer>
      <staticContent><clientCache cacheControlMode="DisableCache" /></staticContent>
    </system.webServer>
  </location>
  <location path="flutter_bootstrap.js">
    <system.webServer>
      <staticContent><clientCache cacheControlMode="DisableCache" /></staticContent>
    </system.webServer>
  </location>
  <location path="main.dart.js">
    <system.webServer>
      <staticContent><clientCache cacheControlMode="DisableCache" /></staticContent>
    </system.webServer>
  </location>
  <location path="version.json">
    <system.webServer>
      <staticContent><clientCache cacheControlMode="DisableCache" /></staticContent>
    </system.webServer>
  </location>
</configuration>
